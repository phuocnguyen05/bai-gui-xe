rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /slots/{slotId} {
      allow read, write: if true;
    }
    match /tickets/{ticketId} {
      allow read, write: if true;
    }
    match /wallet_transactions/{transactionId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
